# syntax=docker/dockerfile:1.7

# The QuantRule server image: one digest, one runtime, every service binary and
# the built client. The image carries no Python interpreter, no Bun runtime, and
# no repository tooling. `data`, `model`, and `simulation` are absent until their
# binaries exist (#643); the Compose file gates them behind a profile.
#
# The host contract is linux/amd64. Windows and macOS run the same image through
# Docker Desktop's Linux backend.

# --- Rust: the three service binaries -------------------------------------
FROM rust:1.99.1-slim-trixie AS rust-builder

# aws-lc-sys needs cmake and a C compiler; rusqlite builds its bundled SQLite
# with the same toolchain.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        perl \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# The manifests first, so a source-only change reuses the dependency build.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
# The strategy registry is compiled into the engine and generated by a build
# script; the image cannot build without it.
COPY docs/registry/indicators.json ./docs/registry/indicators.json

# The cache mounts hold the registry and the target directory across builds.
# The binaries are copied out in the same layer because a cache mount is not
# part of the image.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p quantrule-server --bins \
    && mkdir -p /out/bin \
    && find target/release -maxdepth 1 -type f -name 'qr-*' ! -name '*.d' \
        -exec cp {} /out/bin/ \; \
    && awk -F'"' '/^version = /{print $2; exit}' Cargo.toml > /out/version

# --- Bun: the static client -----------------------------------------------
FROM oven/bun:1.4.2 AS web-builder

WORKDIR /web

COPY apps/web/package.json apps/web/bun.lock ./
RUN bun install --frozen-lockfile

COPY apps/web ./
RUN bun run build

# --- Runtime: Debian slim, no Python, no Bun ------------------------------
FROM debian:trixie-slim AS runtime

LABEL org.opencontainers.image.title="quantrule-server" \
      org.opencontainers.image.description="The QuantRule service runtime and browser client" \
      org.opencontainers.image.source="https://github.com/quant-rule/quant-rule" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"

# curl serves the Compose health probes; ca-certificates is required for any
# outbound TLS. Neither pulls an interpreter.
# libstdc++ and gdb ship Python pretty-printer scripts. The image has no
# interpreter and the constraint is no `.py` file, so the debugger helpers are
# removed rather than left as dead weight.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 quantrule \
    && useradd --system --uid 10001 --gid quantrule \
        --home-dir /srv/quantrule --shell /usr/sbin/nologin quantrule \
    && install -d -o quantrule -g quantrule /srv/static /srv/config /srv/quantrule \
    && find /usr/share -type f -name '*.py' -delete

COPY --from=rust-builder /out/bin/ /usr/local/bin/
COPY --from=rust-builder /out/version /etc/quantrule-version
COPY --from=web-builder /web/dist/ /srv/static/
COPY --chmod=0755 docker/entrypoint.sh /usr/local/bin/quantrule-entry

# The client and the run-config mount are resolved from these paths. Service
# URLs come from the Compose environment; the engine defaults already name the
# Compose hosts.
ENV QR_STATIC_DIR=/srv/static \
    QR_CONFIG_ROOT=/srv/config \
    QR_BIND=0.0.0.0:8080

USER 10001:10001
WORKDIR /srv/quantrule
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/quantrule-entry"]
CMD ["qr-gateway"]
