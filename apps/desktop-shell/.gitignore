# The shell is outside the Cargo workspace and keeps its own target directory.
/target

# Staged frontend: apps/web/dist copied in by scripts/stage-frontend.mjs.
/dist

# Generated by the Tauri CLI. The shell declares no capability file.
/gen/schemas

# Staged package resources: the parallel release build fills these. The README
# files stay tracked.
/resources/sidecars/qr-*
/resources/sidecars/qr-desktop
/resources/config/*
!/resources/config/README.md
