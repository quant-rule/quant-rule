{
  "schema": "quantrule.qualification/v1",
  "id": "Q-SR9-DEV",
  "evidence": {
    "required_partitions": [
      "strategy_dev"
    ],
    "minimum_trades": 30,
    "cost_model": "execution-and-portfolio",
    "multiple_testing": {
      "primary_cells": 6,
      "trials": 12,
      "correction": "bonferroni",
      "family_alpha": 0.05
    }
  },
  "criteria": [
    {
      "id": "drawdown-ceiling",
      "dimension": "drawdown",
      "mandatory": true,
      "metric": "max_drawdown",
      "operator": "<=",
      "threshold": 0.05,
      "evidence_artifact": "portfolio",
      "evidence_field": "metrics.max_drawdown"
    },
    {
      "id": "trade-presence",
      "dimension": "trade_count",
      "mandatory": true,
      "metric": "trades",
      "operator": ">=",
      "threshold": 30,
      "evidence_artifact": "portfolio",
      "evidence_field": "metrics.trades"
    }
  ]
}
