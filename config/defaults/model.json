{
  "schema": "quantrule.model/v4",
  "defaults": {
    "ema": {
      "periods": [
        20,
        50,
        200
      ],
      "active": true
    },
    "rsi": {
      "period": 14,
      "active": true
    },
    "atr": {
      "period": 14,
      "active": true
    },
    "rvol": {
      "period": 20,
      "active": true
    },
    "macd": {
      "fast": 12,
      "slow": 26,
      "signal": 9,
      "active": true
    },
    "adx": {
      "period": 14,
      "threshold": 25.0,
      "slope_bars": 3,
      "active": true
    },
    "events": {
      "level": {
        "references": [
          "ema",
          "pivots"
        ],
        "test_atr": 0.2,
        "break_atr": 0.2
      },
      "divergence": {
        "indicator": "rsi",
        "pivot_scale": "major",
        "window": 2
      },
      "signal": {
        "rsi_levels": [
          30.0,
          50.0,
          70.0
        ],
        "ema_pairs": [
          [
            20,
            50
          ],
          [
            50,
            200
          ],
          [
            20,
            200
          ]
        ],
        "macd": [
          "line_signal_cross",
          "histogram_slope_flip",
          "zero_cross"
        ],
        "di_cross": true,
        "trend_continuation": {
          "enabled": true,
          "adx_threshold": 25.0,
          "adx_slope_bars": 3
        },
        "compression_breakout": {
          "enabled": false,
          "coiling_bars": 5,
          "break_atr": 0.2,
          "rvol_min": 1.2
        },
        "compression_range": {
          "enabled": false,
          "coiling_bars": 5
        }
      }
    },
    "progression": {
      "target_atr": 2.0,
      "stability_bars": 3,
      "invalidation_atr": 0.2,
      "min_target_atr": 0.2
    }
  },
  "structure": {
    "scale": "major"
  },
  "timeframes": {}
}
