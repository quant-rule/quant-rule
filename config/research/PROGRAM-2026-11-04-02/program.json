{
  "schema": "quantrule.research-program/v1",
  "program_id": "PROGRAM-2026-11-04-02",
  "premise": "A 15m directional event has a higher 2 ATR barrier hit rate when it agrees with the last closed 1h trend state (ema_stack in the event direction and adx_regime == 1) than the same 15m event alone, and the 15m event adds beyond the 1h state base.",
  "economic_rationale": "Higher-timeframe trend alignment filters counter-trend 15m triggers. The 1h state is the slowest allowed context; the 15m event provides the timing. If the 1h trend is the missing condition, the conditional event should beat both the unfiltered 15m event and the 1h state base.",
  "tier": "model",
  "changed": "model",
  "frozen": ["strategy", "portfolio"],
  "partition_dev": "model_dev",
  "partition_validation": "model_validation",
  "costs": {
    "commission_bps": 4,
    "slippage_bps": 2,
    "funding": 0
  },
  "green_criteria": {
    "min_events": 200,
    "min_clusters": 20,
    "min_conditional_lift": 0.05,
    "min_incremental_lift": 0.02,
    "conditional_lift_lcb": "> 0",
    "incremental_lift_lcb": "> 0",
    "random_p": "<= 0.05",
    "back_lag": "pass",
    "shuffle_p": "<= 0.05",
    "replication": ">= 2 instruments"
  },
  "correction": {
    "method": "bonferroni",
    "primary_cells": 3
  },
  "max_parallel": 3,
  "iteration_cap": 1,
  "validation_access": "one_shot",
  "stop_rule": "Stop when no primary cell passes. Retire the cross-timeframe premise; do not re-register a variant with a different event, target, stop, horizon, timeframe, filter, or cost.",
