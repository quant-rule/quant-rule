{
  "schema": "quantrule.research-program/v1",
  "program_id": "PROGRAM-2026-11-08-01",
  "premise": "Event sequences, independent-level confluence, freshness, and path expectancy carry forward information that single-bar event votes did not. The model is M1.0; MR5 is a research family, not a model version.",
  "economic_rationale": "Confirmed levels concentrate resting liquidity and stop orders. A failed break, a retest, a confluence of independent references, and a fresh level are liquidity interactions with a counterparty; the path report shows whether the reaction is asymmetric enough to matter after costs.",
  "tier": "model",
  "changed": "model",
  "frozen": [
    "strategy",
    "portfolio"
  ],
  "partition_dev": "model_dev",
  "partition_validation": "model_validation",
  "costs": {
    "commission_bps": 4,
    "slippage_bps": 2,
    "funding": 0
  },
  "green_criteria": {
    "min_events": 200,
    "min_clusters": 20,
    "min_lift": 0.02,
    "lift_lcb": "> 0",
    "random_p": "<= 0.01",
    "shuffle_p": "<= 0.01",
    "back_lag": "pass",
    "replication": ">= 2 instruments",
    "state_increment": ">= 0.01",
    "promotion": "grade A"
  },
  "correction": {
    "method": "bonferroni",
    "primary_cells": 5
  },
  "max_parallel": 20,
  "iteration_cap": 1,
  "validation_access": "one_shot",
  "stop_rule": "Stop when no primary base cell reaches grade A, a validation cell fails, the count gate cannot reach 200 condition-matched predictions and 20 clusters in every primary base cell, a shared prerequisite is missing, or the human stops it. Do not re-register a variant with a different event, timeframe, horizon, target, stop, filter, cost, instrument set, condition, or threshold.",
  "cells": [
    {
      "cell_id": "MR5.1-C01",
