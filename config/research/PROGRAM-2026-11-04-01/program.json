  "max_parallel": 4,
  "iteration_cap": 1,
  "validation_access": "one_shot",
  "stop_rule": "Stop when no primary cell passes. Retire the four divergence subtypes; do not re-register a variant with a different target, stop, horizon, timeframe, or filter.",
