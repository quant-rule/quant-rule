{
  "schema": "quantrule.research-program/v1",
  "program_id": "PROGRAM-2026-11-08-03",
  "family": "MR7",
  "run_prefix": "mr7",
  "premise": "A sweep of the completed opening range that closes back inside is a stop-run and reclaim at a session extreme; the reclaim carries a reversal edge that a generic failed breakout does not, while a sweep that closes outside is the continuation control. The model is M1.1; MR7 is a research family, not a model version.",
  "economic_rationale": "The opening range is the first auction of the session and a dense cluster of early stops. A bar that trades beyond it and closes back inside is evidence that the sweep was rejected; the counterparty who sold the high or bought the low is trapped. A sweep that closes outside is the continuation control: if it also reverses, the reclaim is not the mechanism. MR5 and MR6 found the only positive directional evidence in level/liquidity interaction, not in trend or participation families; MR7 isolates that evidence in one event and adds a cost-aware path gate.",
  "tier": "model",
  "changed": "model",
  "frozen": [
    "strategy",
    "portfolio"
  ],
  "partition_dev": "model_dev",
  "partition_validation": "model_validation",
  "costs": {
    "commission_bps": 4,
    "slippage_bps": 2,
    "funding": 0
  },
  "green_criteria": {
    "min_events": 200,
    "min_clusters": 20,
    "min_lift": 0.02,
    "lift_lcb": "> 0",
    "random_p": "<= 0.01",
    "shuffle_p": "<= 0.01",
    "back_lag": "pass",
    "replication": ">= 2 instruments",
    "state_increment": ">= 0.01",
    "promotion": "grade A",
    "path_mean_net_r": "> 0"
  },
  "correction": {
    "method": "bonferroni",
    "primary_cells": 5
  },
  "max_parallel": 1,
  "iteration_cap": 1,
  "validation_access": "one_shot",
  "stop_rule": "Stop when no primary base cell passes the hit-rate and path gates, the count gate cannot reach 200 condition-matched predictions and 20 clusters in every primary base cell, the no-reclaim control also reverses, a shared prerequisite is missing, or the human stops it. Do not re-register a variant with a different event, timeframe, horizon, target, stop, filter, cost, instrument set, condition, or threshold.",
