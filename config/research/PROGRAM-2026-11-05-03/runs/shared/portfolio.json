{
  "schema": "quantrule.portfolio/v1",
  "initial_cash": 10000.0,
  "currency": "USD",
  "sizing": {
    "mode": "fixed_notional",
    "notional": 10000.0,
    "quantity_step": 0.0001
  },
  "leverage": 1.0,
  "max_open_positions": 1,
  "allow_short": true,
  "commission": {
    "rate": 0.001,
    "base": "equity",
    "per": "operation"
  },
  "funding": {
    "rate": 0.0001,
    "interval_hours": 8
  },
  "max_drawdown": {
    "limit": 0.2,
    "action": "halt"
  },
  "mark_to_market": "bar_close"
}
