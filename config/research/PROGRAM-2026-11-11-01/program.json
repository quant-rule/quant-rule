    "min_clusters": 20,
    "min_conditional_lift": 0.05,
    "min_incremental_lift": 0.02,
    "conditional_lift_lcb": "> 0",
    "incremental_lift_lcb": "> 0",
    "random_p": "<= 0.05",
    "back_lag": "pass",
    "shuffle_p": "<= 0.05",
    "replication": ">= 2 instruments"
  },
  "correction": {
    "method": "none",
    "primary_cells": 1
  },
  "max_parallel": 1,
  "iteration_cap": 1,
  "validation_access": "one_shot",
  "stop_rule": "Stop when the primary cell fails. Retire the trend-pullback premise; do not re-register a variant with a different EMA period, ADX threshold, target, stop, horizon, timeframe, filter, or cost.",
