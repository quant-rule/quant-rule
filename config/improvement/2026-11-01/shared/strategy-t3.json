{
  "schema": "quantrule.strategy/v3",
  "rule": "ladder-context",
  "thesis": "Higher-timeframe trend continuation captures larger moves and reduces the cost drag that dominates the lower-timeframe control.",
  "ladder": [
    "1h",
    "4h"
  ],
  "weights": {
    "direction": {
      "4h": 1.0
    },
    "momentum": {
      "4h": 1.0
    },
    "structure": {
      "4h": 1.0
    },
    "progression": {
      "4h": 1.0
    }
  },
  "entry": {
    "execution": {
      "direction_min": 0.1,
      "momentum_min": 0.1,
      "structure_min": 0.0,
      "structure_shift": {
        "from_max": 0,
        "to_min": 1
      }
    },
    "context": {
      "direction": {
        "kind": "bullish",
        "share_min": 0.5
      },
      "momentum": {
        "kind": "not_bearish",
        "bearish_share_max": 0.5
      },
      "structure": {
        "conflict_count_max": 0
      },
      "progression": {
        "direction": "bullish",
        "late_or_terminal_count_max": 0
      }
    }
  },
  "exit": {
    "on": [
      "context_lost",
      "structure_lost"
    ]
  },
  "risk": {
    "stop": {
      "kind": "atr",
      "multiple": 3.0
    },
    "target": {
      "kind": "reward_to_risk",
      "multiple": 3.0
    }
  },
  "no_trade": {
    "missing_context": "reject",
    "require_contiguous_execution": true
  }
}
