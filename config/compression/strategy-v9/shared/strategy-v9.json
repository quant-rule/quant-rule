{
  "schema": "quantrule.strategy/v9",
  "rule": "compression-breakout",
  "thesis": "The accepted 1m compression-expansion baseline: take the breakout side at the next open, target 4 ATR, stop 1 ATR, and exit after 20 bars.",
  "ladder": ["1m", "5m"],
  "event": {
    "timeframe": "1m",
    "event_type": 3,
    "subtype": 7,
    "source": 5
  },
  "window_bars": 1,
  "time_stop_bars": 20,
  "risk": {
    "stop": { "kind": "atr", "multiple": 1.0 },
    "target": { "kind": "reward_to_risk", "multiple": 4.0 }
  },
  "no_trade": {
    "missing_context": "reject",
    "require_contiguous_execution": true
  }
}
