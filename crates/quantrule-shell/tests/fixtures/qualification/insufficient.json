{
  "schema": "quantrule.qualification/v1",
  "id": "Q-FIXTURE-INSUFFICIENT",
  "evidence": {
    "required_partitions": ["strategy_validation"],
    "minimum_trades": 1,
    "cost_model": "execution-and-portfolio",
    "multiple_testing": {
      "primary_cells": 2,
      "trials": 2,
      "correction": "holm",
      "family_alpha": 0.05
    }
  },
  "criteria": [
    {
      "id": "trade-count",
      "dimension": "trade_count",
      "mandatory": true,
      "metric": "trades",
      "operator": ">=",
      "threshold": 1,
      "evidence_artifact": "portfolio",
      "evidence_field": "metrics.trades"
    },
    {
      "id": "drawdown",
      "dimension": "drawdown",
      "mandatory": true,
      "metric": "max_drawdown",
      "operator": "<=",
      "threshold": 0.2,
      "evidence_artifact": "portfolio",
      "evidence_field": "metrics.max_drawdown"
    }
  ]
}
