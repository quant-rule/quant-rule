# syntax=docker/dockerfile:1.7
#
# The release image is assembled from binaries built once on `main`. It does not
# compile Rust. The release gate verifies the artifact manifest before this file
# runs.

FROM oven/bun:1.4.2 AS web-builder

WORKDIR /web

COPY apps/web/package.json apps/web/bun.lock ./
RUN bun install --frozen-lockfile

COPY apps/web ./
RUN bun run build

FROM debian:trixie-slim AS runtime

LABEL org.opencontainers.image.title="quantrule-server" \
      org.opencontainers.image.description="The QuantRule service runtime and browser client" \
      org.opencontainers.image.source="https://github.com/quant-rule/quant-rule" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 quantrule \
    && useradd --system --uid 10001 --gid quantrule \
        --home-dir /srv/quantrule --shell /usr/sbin/nologin quantrule \
    && install -d -o quantrule -g quantrule /srv/static /srv/config /srv/quantrule \
    && find /usr/share -type f -name '*.py' -delete

COPY release-binaries/qr-* /usr/local/bin/
COPY release-binaries/version /etc/quantrule-version
RUN chmod +x /usr/local/bin/qr-*
COPY --from=web-builder /web/dist/ /srv/static/
COPY --chmod=0755 docker/entrypoint.sh /usr/local/bin/quantrule-entry
COPY --chmod=0755 docker/check-no-python.sh /usr/local/bin/check-no-python
RUN /usr/local/bin/check-no-python

ENV QR_STATIC_DIR=/srv/static \
    QR_CONFIG_ROOT=/srv/config \
    QR_BIND=0.0.0.0:8080

# The entrypoint starts as root only to stage the file-backed secrets into a
# UID-10001 directory, then drops to 10001 before exec. Starting as 10001
# directly leaves the mounted secrets unreadable, and every migration job
# fails with "cannot be read". The local Dockerfile uses the same split.
USER 0:0
WORKDIR /srv/quantrule
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/quantrule-entry"]
CMD ["qr-gateway"]
