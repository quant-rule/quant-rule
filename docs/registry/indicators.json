{
  "schema": "quantrule.registry/v1",
  "version": "2026-11-04.3",
  "indicators": [
    {
      "id": "ema",
      "code": 1,
      "name": "Exponential moving average",
      "taxonomy": "trend",
      "role": "signal",
      "claim": "The relative position of the fast, middle, and slow EMA describes directional alignment; a stack state is followed by a directional move more often than the base rate.",
      "formula": "seed = SMA(first n closes); alpha = 2/(n+1); ema_t = alpha*close_t + (1-alpha)*ema_(t-1)",
      "inputs": [
        "close"
      ],
      "parameters": [
        "model.ema.periods",
        "model.level.references",
        "model.level.test_atr",
        "model.level.break_atr"
      ],
      "outputs": [
        "ema_fast",
        "ema_mid",
        "ema_slow",
        "ema_stack_state"
      ],
      "availability": "n closed bars",
      "events": [
        "signal.ema_pair_cross",
        "signal.ema_stack_change"
      ],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases"
      ],
      "status": "active"
    },
    {
      "id": "rsi",
      "code": 2,
      "name": "Relative strength index",
      "taxonomy": "momentum",
      "role": "signal",
      "claim": "RSI threshold crossings mark momentum shifts; the forward return after a crossing differs from the base rate.",
      "formula": "Wilder average gain/loss; rsi = 100 - 100/(1 + avg_gain/avg_loss)",
      "inputs": [
        "close"
      ],
      "parameters": [
        "model.rsi.period",
        "model.signal.rsi_levels"
      ],
      "outputs": [
        "rsi",
        "rsi_zone"
      ],
      "availability": "n+1 closed bars",
      "events": [
        "signal.rsi_threshold",
        "signal.rsi_zone_change",
        "divergence.rsi_regular_bullish",
        "divergence.rsi_regular_bearish",
        "divergence.rsi_hidden_bullish",
        "divergence.rsi_hidden_bearish"
      ],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases"
      ],
      "status": "active"
    },
    {
      "id": "atr",
      "code": 3,
      "name": "Average true range",
      "taxonomy": "volatility",
      "role": "context",
      "claim": "ATR and ATR ratio describe volatility context; they do not predict direction.",
      "formula": "TR = max(high-low, |high-prev_close|, |low-prev_close|); Wilder mean",
      "inputs": [
        "high",
        "low",
        "close"
      ],
      "parameters": [
        "model.atr.period"
      ],
      "outputs": [
        "atr",
        "atr_ratio"
      ],
      "availability": "n+1 closed bars",
      "events": [],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases"
      ],
      "status": "active"
    },
    {
      "id": "rvol",
      "code": 4,
      "name": "Relative volume",
      "taxonomy": "volatility",
      "role": "context",
      "claim": "Relative volume describes participation; it does not predict direction.",
      "formula": "volume / SMA(volume, n)",
      "inputs": [
        "volume"
      ],
      "parameters": [
        "model.rvol.period"
      ],
      "outputs": [
        "rvol"
      ],
      "availability": "n closed bars with volume",
      "events": [],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases"
      ],
      "status": "active"
    },
    {
      "id": "macd",
      "code": 5,
      "name": "Moving Average Convergence Divergence",
      "taxonomy": "trend",
      "role": "signal",
      "claim": "MACD line/signal and histogram changes mark trend and momentum shifts; forward outcomes differ from the base rate.",
      "formula": "line = EMA(close,fast) - EMA(close,slow); signal = EMA(line,signal); histogram = line - signal",
      "inputs": [
        "close"
      ],
      "parameters": [
        "model.macd.fast",
        "model.macd.slow",
        "model.macd.signal",
        "model.macd.active",
        "model.signal.macd"
      ],
      "outputs": [
        "macd_line",
        "macd_signal",
        "macd_histogram",
        "macd_state",
        "macd_histogram_state"
      ],
      "availability": "slow bars for the line; slow+signal-1 for the signal",
      "events": [
        "signal.macd_line_signal_cross",
        "signal.macd_histogram_slope_flip",
        "signal.macd_zero_cross"
      ],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases"
      ],
      "status": "active"
    },
    {
      "id": "pivots",
      "code": 6,
      "name": "Confirmed swing pivots",
      "taxonomy": "structure",
      "role": "signal",
      "claim": "Confirmed pivots define price levels; a level test is followed by a path reaction more often than a matched barrier baseline.",
      "formula": "strict local extreme over k bars each side; confirmed at i+k",
      "inputs": [
        "high",
        "low"
      ],
      "parameters": [
        "model.pivots.minor",
        "model.pivots.major",
        "model.level.references",
        "model.level.test_atr",
        "model.level.break_atr"
      ],
      "outputs": [
        "minor_high",
        "minor_low",
        "major_high",
        "major_low",
        "confirmed_levels"
      ],
      "availability": "k bars after the pivot",
      "events": [
        "level.test",
        "level.cross",
        "level.break",
        "divergence.rsi_regular_bullish",
        "divergence.rsi_regular_bearish",
        "divergence.rsi_hidden_bullish",
        "divergence.rsi_hidden_bearish"
      ],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases"
      ],
      "status": "active"
    },
    {
      "id": "context",
      "code": 7,
      "name": "Volatility and participation regime",
      "taxonomy": "volatility",
      "role": "context",
      "claim": "ATR ratio and RVOL ratio define a regime; they condition other signals but do not predict direction alone.",
      "formula": "atr_ratio = ATR/SMA(ATR,20); rvol_ratio = volume/SMA(volume,20); bucket by 1.0 thresholds",
      "inputs": [
        "atr",
        "rvol"
      ],
      "parameters": [
        "model.context.atr_ratio_period",
        "model.context.rvol_period",
        "model.context.threshold"
      ],
      "outputs": [
        "atr_ratio",
        "rvol_ratio",
        "context_code"
      ],
      "availability": "after both ratios are available",
      "events": [
        "signal.compression_breakout"
      ],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases"
      ],
      "status": "active"
    },
    {
      "id": "progression",
      "code": 8,
      "name": "Structural leg progression",
      "taxonomy": "progression",
      "role": "context",
      "claim": "A leg's stage describes how far a move has travelled; target-hit-before-invalidation differs from the base rate.",
      "formula": "progress = (close-origin)/(target-origin); stage 0..5 from progress and lifecycle",
      "inputs": [
        "close",
        "atr",
        "pivots"
      ],
      "parameters": [
        "model.progression.target_atr",
        "model.progression.stability_bars",
        "model.progression.invalidation_atr",
        "model.progression.min_target_atr"
      ],
      "outputs": [
        "published_leg",
        "minor_leg",
        "major_leg",
        "progression_stage_code",
        "progress"
      ],
      "availability": "origin confirmation and target stability",
      "events": [],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases"
      ],
      "status": "active"
    },
    {
      "id": "adx",
      "code": 9,
      "name": "Average Directional Index",
      "taxonomy": "trend",
      "role": "context",
      "claim": "ADX measures trend strength; a high and rising ADX is a condition for trend continuation, not a directional signal by itself.",
      "formula": "TR, +DM, -DM; Wilder-smoothed; +DI=100*+DM/TR; -DI=100*-DM/TR; DX=100*|+DI--DI|/(+DI+-DI); ADX=Wilder(DX,n)",
      "inputs": [
        "high",
        "low",
        "close"
      ],
      "parameters": [
        "model.adx.period",
        "model.adx.threshold",
        "model.adx.slope_bars",
        "model.adx.active",
        "model.signal.trend_continuation",
        "model.signal.trend_adx_threshold",
        "model.signal.trend_adx_slope_bars"
      ],
      "outputs": [
        "adx",
        "adx_regime",
        "adx_slope"
      ],
      "availability": "2*n-1 closed bars",
      "events": [],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases",
        "property"
      ],
      "status": "active"
    },
    {
      "id": "dmi",
      "code": 10,
      "name": "Directional Movement Index",
      "taxonomy": "trend",
      "role": "signal",
      "claim": "The sign and crossing of +DI and -DI describe directional movement; a DI cross is followed by a directional path more often than the base rate.",
      "formula": "+DI=100*Wilder(+DM)/Wilder(TR); -DI=100*Wilder(-DM)/Wilder(TR); DI state=sign(+DI--DI)",
      "inputs": [
        "high",
        "low",
        "close"
      ],
      "parameters": [
        "model.adx.period",
        "model.adx.active",
        "model.signal.di_cross"
      ],
      "outputs": [
        "di_plus",
        "di_minus",
        "di_state"
      ],
      "availability": "n closed bars",
      "events": [
        "signal.di_cross"
      ],
      "tests": [
        "golden",
        "causality",
        "determinism",
        "edge_cases"
      ],
      "status": "active"
    }
  ],
