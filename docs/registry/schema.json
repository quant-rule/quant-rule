{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-rule.dev/registry/v1.json",
  "title": "QuantRule indicator and parameter registry",
  "type": "object",
  "required": ["schema", "version", "indicators", "events", "parameters", "codes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quantrule.registry/v1" },
    "version": { "type": "string", "minLength": 1 },
    "indicators": {
      "type": "array",
      "items": { "$ref": "#/$defs/indicator" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "codes": { "$ref": "#/$defs/codes" }
  },
  "$defs": {
    "role": { "enum": ["signal", "context", "diagnostic"] },
    "status": { "enum": ["active", "planned", "retired", "experimental"] },
    "taxonomy": {
      "enum": [
        "trend",
        "momentum",
        "structure",
        "progression",
        "volatility",
        "volume",
        "participation",
        "flow",
        "price_action",
        "path",
        "cross_asset",
        "session",
        "calendar"
      ]
    },
    "indicator": {
      "type": "object",
      "required": [
        "id",
        "code",
        "name",
        "taxonomy",
        "role",
        "claim",
        "formula",
        "inputs",
        "parameters",
        "outputs",
        "availability",
        "events",
        "tests",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "code": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "taxonomy": { "$ref": "#/$defs/taxonomy" },
        "role": { "$ref": "#/$defs/role" },
        "claim": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "parameters": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "availability": { "type": "string", "minLength": 1 },
        "events": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": {
            "enum": [
              "golden",
              "causality",
              "determinism",
              "edge_cases",
              "property",
              "event",
              "boundary",
              "benchmark"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "code",
        "event_type",
        "subtype",
        "source",
        "indicator",
        "role",
        "claim",
        "formula",
        "parameters",
        "tests",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
        "code": { "type": "integer", "minimum": 1 },
        "event_type": { "type": "integer", "enum": [1, 2, 3] },
        "subtype": { "type": "integer", "minimum": 1 },
        "source": { "type": "integer", "minimum": 1 },
        "sources": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "indicator": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/role" },
        "claim": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "precedence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": {
            "enum": [
              "golden",
              "causality",
              "determinism",
              "edge_cases",
              "property",
              "event",
              "boundary",
              "benchmark"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "id",
        "path",
        "type",
        "default",
        "configurable",
        "affects",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
        "path": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "integer",
            "number",
            "boolean",
            "string",
            "array<integer>",
            "array<number>",
            "array<string>",
            "array<array<integer>>",
            "object"
          ]
        },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "enum": { "type": "array" },
        "unit": {
          "enum": [
            "bars",
            "fraction",
            "atr",
            "seconds",
            "bps",
            "currency",
            "period",
            "none"
          ]
        },
        "configurable": { "type": "boolean" },
        "affects": {
          "type": "array",
          "items": {
            "enum": [
              "model",
              "strategy",
              "policy",
              "execution",
              "portfolio",
              "analytics"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "codes": {
      "type": "object",
      "required": [
        "event_types",
        "level_subtypes",
        "divergence_subtypes",
        "signal_subtypes",
        "sources",
        "roles",
        "scales",
        "target_bases",
        "lifecycles",
        "stages",
        "unavailable_reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "event_types": { "$ref": "#/$defs/codeMap" },
        "level_subtypes": { "$ref": "#/$defs/codeMap" },
        "divergence_subtypes": { "$ref": "#/$defs/codeMap" },
        "signal_subtypes": { "$ref": "#/$defs/codeMap" },
        "sources": { "$ref": "#/$defs/codeMap" },
        "roles": { "$ref": "#/$defs/codeMap" },
        "scales": { "$ref": "#/$defs/codeMap" },
        "target_bases": { "$ref": "#/$defs/codeMap" },
        "lifecycles": { "$ref": "#/$defs/codeMap" },
        "stages": { "$ref": "#/$defs/codeMap" },
        "unavailable_reasons": { "$ref": "#/$defs/codeMap" }
      }
    },
    "codeMap": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]+$": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
