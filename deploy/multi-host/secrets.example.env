# QuantRule multi-host deployment — operator secrets template.
#
# Copy this file to secrets.env in this directory, fill every value, and keep
# the copy at mode 600. `qr-deploy render` reads secrets.env and writes the
# resolved values into the ignored env/ files; neither file is ever committed.
# A committed secret is a security finding, not a configuration mistake.
#
# The object-store user and password are also the S3 credentials every service
# presents to MinIO, so AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY must match
# QR_OBJECT_STORE_USER and QR_OBJECT_STORE_PASSWORD.

# Postgres: shared by every schema owner on the core, compute, and gateway hosts.
QR_POSTGRES_USER=quantrule
QR_POSTGRES_PASSWORD=replace-with-a-long-random-value
QR_POSTGRES_DB=quantrule

# Object store: MinIO root credentials and the bucket the runtime assumes. The
# renderer maps QR_OBJECT_STORE_BUCKET to QR_OBJECT_BUCKET in the env files.
QR_OBJECT_STORE_USER=quantrule
QR_OBJECT_STORE_PASSWORD=replace-with-a-long-random-value
QR_OBJECT_STORE_BUCKET=quantrule

# Queue: RabbitMQ user, password, and virtual host.
QR_QUEUE_USER=quantrule
QR_QUEUE_PASSWORD=replace-with-a-long-random-value
QR_QUEUE_VHOST=/

# Gateway gate. Leave empty only when the gateway is reachable from the private
# overlay alone; set it before any port is reachable from another network.
# `tools/token.sh` prints a 256-bit value.
QR_BEARER_TOKEN=

# S3 credentials used by the services. They must equal the object-store values
# above; MinIO has no separate IAM user in this profile.
AWS_ACCESS_KEY_ID=quantrule
AWS_SECRET_ACCESS_KEY=replace-with-the-object-store-password
