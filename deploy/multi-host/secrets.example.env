# QuantRule multi-host deployment — operator secrets template.
#
# Copy this file to secrets.env in this directory, fill every value, and keep
# the copy at mode 600. `qr-deploy render` reads secrets.env and writes a
# mode-600 file per secret under the ignored env/ directory; the service env
# files name `_FILE` paths under /run/secrets. Neither file is ever committed.
# A committed secret is a security finding, not a configuration mistake.
#
# The object-store user and password are also the S3 credentials every service
# presents to MinIO. The renderer writes them to the two credential files; the
# services never read AWS_ACCESS_KEY_ID or the AWS default chain.

# Postgres: the admin role used by the infrastructure and db-bootstrap. The
# bootstrap creates the four logical databases and eight owner/app roles; the
# v2 profile uses this one password for all of them.
QR_POSTGRES_USER=quantrule
QR_POSTGRES_PASSWORD=replace-with-a-long-random-value
QR_POSTGRES_DB=quantrule

# Object store: MinIO root credentials and the bucket the runtime assumes. The
# renderer maps QR_OBJECT_STORE_BUCKET to QR_OBJECT_BUCKET in the env files.
QR_OBJECT_STORE_USER=quantrule
QR_OBJECT_STORE_PASSWORD=replace-with-a-long-random-value
QR_OBJECT_STORE_BUCKET=quantrule

# Queue: RabbitMQ user, password, and virtual host.
QR_QUEUE_USER=quantrule
QR_QUEUE_PASSWORD=replace-with-a-long-random-value
QR_QUEUE_VHOST=/

# Gateway gate. The example descriptor enables auth.gateway_token, so this must
# be non-empty; `qr-deploy validate --secrets` rejects an empty value. Use
# `tools/token.sh`, which prints a 256-bit value. The renderer writes it to a
# mode-600 file; the gateway re-reads that file on rotation.
QR_BEARER_TOKEN=replace-with-a-256-bit-token

# The S3 access key and secret are QR_OBJECT_STORE_USER and
# QR_OBJECT_STORE_PASSWORD above; the renderer writes them to the two credential
# files. No AWS_* variable is needed or read.
